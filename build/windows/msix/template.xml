<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hitk.exe"
        Arguments=""
        InstallLocation="C:\Program Files\HitK\HitK">
    </Installer>
    <PackageInformation
        PackageName="HitK"
        PackageDisplayName="HitK"
        PublisherName="CN=HitK"
        PublisherDisplayName="HitK"
        Version="0.1.0.0"
        PackageDescription="HitK - Agentic Search Knowledge Base">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.hitk.app"
                Description="HitK - Agentic Search Knowledge Base"
                DisplayName="HitK"
                ExecutableName="hitk.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>HitK</DisplayName>
            <PublisherDisplayName>HitK</PublisherDisplayName>
            <Description>HitK - Agentic Search Knowledge Base</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hitk.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
