# Copy this file to .env for local development. .env is ignored by git.
#
# Enable script-based Skills such as SkillHub CLI packages. The application
# defaults to "resolve" when this variable is absent.
HITK_SKILL_COMPAT=full

# HITK_SKILL_ROOT, HITK_SKILL_PAYLOAD and HITK_RUNTIME_CACHE are injected into
# each Skill process automatically. Do not set them here.

# Optional: isolate development data from the normal HitK data directory.
# HITK_DATA_DIR=D:\code\HitK\.hitk-dev-data

# Optional: override the staged runtime used by the application. Normally the
# development build uses bin\runtime automatically.
# HITK_RUNTIME_ROOT=D:\code\HitK\bin\runtime

# Optional network settings inherited by runtime/package downloads.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Only needed when publishing the optional document component.
# MODELSCOPE_API_TOKEN=

# Optional integration-test fixtures.
# HITK_WATERMARK_ZIP=
# HITK_WATERMARK_OUTPUT=
# HITK_SKILLHUB_RANDOM_ROOT=
# HITK_SKILLHUB_BATCH2_ROOT=
# HITK_DOCLING_COMPONENT_ZIP=
# HITK_DOCLING_INPUT=
